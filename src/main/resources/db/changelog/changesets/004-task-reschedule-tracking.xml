<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="4" author="tasker">
        <addColumn tableName="backlog_task">
            <column name="reschedule_count" type="INT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <!--
                Soft reference to planning_session.id. No FK constraint: sessions may be
                hard-deleted by retention policy and we don't want cascades into the task table.
            -->
            <column name="last_scheduled_in_session_id" type="UUID">
                <constraints nullable="true"/>
            </column>
        </addColumn>

        <createIndex tableName="backlog_task" indexName="idx_backlog_task_last_scheduled_session">
            <column name="last_scheduled_in_session_id"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
