<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
        time_zone_detection_pending: true from registration until the SPA has reported the
        browser's time zone (or the user has saved settings themselves). Existing rows default to
        false on purpose: only new accounts get their zone detected, existing ones keep what they have.
    -->
    <changeSet id="017-1-time-zone-detection-pending" author="tasker">
        <addColumn tableName="user_settings">
            <column name="time_zone_detection_pending" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
        </addColumn>
    </changeSet>

</databaseChangeLog>
