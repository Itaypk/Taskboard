<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="10" author="tasker">
        <createTable tableName="planned_task">
            <column name="id" type="UUID">
                <constraints nullable="false" primaryKey="true"/>
            </column>
            <column name="session_id" type="UUID">
                <constraints nullable="false" foreignKeyName="fk_planned_task_session"
                             references="planning_session(id)"/>
            </column>
            <column name="user_id" type="UUID">
                <constraints nullable="false" foreignKeyName="fk_planned_task_user"
                             references="users(id)"/>
            </column>
            <column name="backlog_task_id" type="UUID"/>
            <column name="title" type="VARCHAR(512)">
                <constraints nullable="false"/>
            </column>
            <column name="notes" type="LONGVARCHAR"/>
            <column name="position" type="INT">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createIndex tableName="planned_task" indexName="idx_planned_task_session">
            <column name="session_id"/>
        </createIndex>

        <createIndex tableName="planned_task" indexName="idx_planned_task_user">
            <column name="user_id"/>
        </createIndex>

        <createTable tableName="planned_task_slot">
            <column name="id" type="UUID">
                <constraints nullable="false" primaryKey="true"/>
            </column>
            <column name="planned_task_id" type="UUID">
                <constraints nullable="false" foreignKeyName="fk_planned_task_slot_task"
                             references="planned_task(id)"/>
            </column>
            <column name="start_iso" type="VARCHAR(64)">
                <constraints nullable="false"/>
            </column>
            <column name="end_iso" type="VARCHAR(64)">
                <constraints nullable="false"/>
            </column>
            <column name="label" type="VARCHAR(256)"/>
        </createTable>

        <createIndex tableName="planned_task_slot" indexName="idx_planned_task_slot_task">
            <column name="planned_task_id"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
