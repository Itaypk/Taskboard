<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="4" author="tasker">
        <!-- 1. Add nullable column first so existing rows are accepted -->
        <addColumn tableName="backlog_task">
            <column name="sort_key" type="VARCHAR(255)">
                <constraints nullable="true"/>
            </column>
        </addColumn>

        <!--
            2. Backfill: assign evenly-spaced single-character sort keys within
               each user's task list, ordered by created_at.
               We use base-26 letters (a, b, c, …) spaced by a fixed step so
               there is room to insert between any two consecutive initial keys.
               The SQL ROW_NUMBER window gives each task a stable integer rank
               per user; we map that to a sort key string like "Gm", "Ks", etc.
               using simple arithmetic that produces values spread across the
               printable-ASCII range (codes 48–122, i.e. '0'–'z').

               For simplicity and database portability the backfill uses a
               deliberate formula:  chr(48 + (rank * 8) % 75)
               which spreads 75-character-wide steps through the printable
               range without overflowing.  Real midpoint arithmetic is handled
               in the Kotlin SortKeyGenerator.
        -->
        <sql splitStatements="false">
            UPDATE backlog_task bt
            SET sort_key = (
                SELECT REPEAT(
                    CHR(48 + ((ranked.rn * 8) % 75)),
                    1
                )
                FROM (
                    SELECT id,
                           ROW_NUMBER() OVER (
                               PARTITION BY user_id
                               ORDER BY created_at ASC, id ASC
                           ) AS rn
                    FROM backlog_task
                ) ranked
                WHERE ranked.id = bt.id
            )
        </sql>

        <!-- 3. Now enforce NOT NULL -->
        <addNotNullConstraint tableName="backlog_task"
                              columnName="sort_key"
                              columnDataType="VARCHAR(255)"
                              defaultNullValue="U"/>

        <!-- 4. Index for efficient per-user ordered queries -->
        <createIndex tableName="backlog_task"
                     indexName="idx_backlog_task_user_sort_key">
            <column name="user_id"/>
            <column name="sort_key"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
