<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
        Fixed-window counter so repeated settings-email-verification requests can't be used to spam
        an inbox. One row per user already exists, so the window lives directly on it rather than in
        a separate per-request log table.
    -->
    <changeSet id="007-1-email-verification-rate-limit" author="tasker">
        <addColumn tableName="users">
            <column name="email_verification_request_count" type="INT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="email_verification_request_window_start" type="TIMESTAMP"/>
        </addColumn>
    </changeSet>

</databaseChangeLog>
