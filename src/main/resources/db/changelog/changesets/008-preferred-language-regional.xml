<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">

    <changeSet id="8" author="system">
        <update tableName="user_settings">
            <column name="preferred_language" value="en-US"/>
            <where>preferred_language = 'en'</where>
        </update>
        <addDefaultValue tableName="user_settings" columnName="preferred_language" defaultValue="en-US"/>
    </changeSet>

</databaseChangeLog>
