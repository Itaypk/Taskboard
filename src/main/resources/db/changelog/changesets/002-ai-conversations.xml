<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="2" author="tasker">
        <createTable tableName="ai_conversation">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="user_id" type="UUID">
                <constraints nullable="false" foreignKeyName="fk_ai_conversation_user" references="users(id)"/>
            </column>
            <column name="conversation_type" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="model" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="temperature" type="DOUBLE">
                <constraints nullable="true"/>
            </column>
            <column name="ttl_days" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="last_activity_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="soft_deleted_at" type="TIMESTAMP">
                <constraints nullable="true"/>
            </column>
            <column name="total_prompt_tokens" type="INT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="total_completion_tokens" type="INT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createIndex tableName="ai_conversation" indexName="idx_ai_conversation_user_status">
            <column name="user_id"/>
            <column name="status"/>
        </createIndex>

        <createIndex tableName="ai_conversation" indexName="idx_ai_conversation_status_activity">
            <column name="status"/>
            <column name="last_activity_at"/>
        </createIndex>

        <createTable tableName="ai_message">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="conversation_id" type="UUID">
                <constraints nullable="false" foreignKeyName="fk_ai_message_conversation"
                             references="ai_conversation(id)" deleteCascade="true"/>
            </column>
            <column name="role" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="content" type="TEXT">
                <constraints nullable="true"/>
            </column>
            <column name="tool_calls_json" type="TEXT">
                <constraints nullable="true"/>
            </column>
            <column name="tool_call_id" type="VARCHAR(255)">
                <constraints nullable="true"/>
            </column>
            <column name="tool_name" type="VARCHAR(255)">
                <constraints nullable="true"/>
            </column>
            <column name="position" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="prompt_tokens" type="INT">
                <constraints nullable="true"/>
            </column>
            <column name="completion_tokens" type="INT">
                <constraints nullable="true"/>
            </column>
            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createIndex tableName="ai_message" indexName="idx_ai_message_conversation_position">
            <column name="conversation_id"/>
            <column name="position"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
