<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
        Phase 2a app-driven reminder delivery:
          - user_settings.app_reminders : per-user opt-in for app/Telegram slot reminders. Defaults
                                          to true; in practice only users with a deliverable channel
                                          are actually notified (the channel gate skips the rest).
          - scheduled_notification.attempts : delivery retry counter; a transient send failure leaves
                                          the row PENDING for retry until success, the cap, or EXPIRED.
    -->
    <changeSet id="009-1-app-reminders" author="tasker">
        <addColumn tableName="user_settings">
            <column name="app_reminders" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
        </addColumn>
    </changeSet>

    <changeSet id="009-2-notification-attempts" author="tasker">
        <addColumn tableName="scheduled_notification">
            <column name="attempts" type="INT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
        </addColumn>
    </changeSet>

    <!--
        Phase 2b interactive / AI-generated reminders:
          - user_settings.ai_enhanced_reminders : per-user opt-out for AI-generated reminder copy.
                                          Defaults to true; only meaningful (and only surfaced in
                                          settings) when ai_enabled is also true. When off — or when
                                          AI is disabled — reminders fall back to the static template.
          - scheduled_notification.snoozed : true for rows re-queued by a "snooze" tap. The dispatcher
                                          skips its "slot start already passed -> EXPIRED" gate for
                                          these, so a snooze always fires at fire_at regardless of slot
                                          timing (snoozing applies to the notification, not the slot).
    -->
    <changeSet id="009-3-ai-enhanced-reminders" author="tasker">
        <addColumn tableName="user_settings">
            <column name="ai_enhanced_reminders" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
        </addColumn>
    </changeSet>

    <changeSet id="009-4-notification-snoozed" author="tasker">
        <addColumn tableName="scheduled_notification">
            <column name="snoozed" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
        </addColumn>
    </changeSet>

</databaseChangeLog>
