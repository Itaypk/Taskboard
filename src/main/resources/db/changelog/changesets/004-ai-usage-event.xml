<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
        Per-call AI usage accounting. One row per OpenRouter call (success or error), written by
        AiUsageTracker right after AiClient.chat returns. Holds only metadata + token counts (no
        prompt/response content), so it is not encrypted. The (user_id, created_at) index backs the
        future per-user rate limiter's "tokens since T" query.
    -->
    <changeSet id="4" author="tasker">
        <createTable tableName="ai_usage_event">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="user_id" type="UUID">
                <constraints nullable="false"
                             foreignKeyName="fk_ai_usage_event_user" references="users(id)"/>
            </column>
            <column name="conversation_type" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="session_id" type="UUID"/>
            <column name="conversation_id" type="UUID"/>
            <column name="model" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="provider" type="VARCHAR(100)"/>
            <column name="prompt_tokens" type="INT"/>
            <column name="completion_tokens" type="INT"/>
            <column name="total_tokens" type="INT"/>
            <column name="status" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createIndex tableName="ai_usage_event" indexName="idx_ai_usage_event_user_created">
            <column name="user_id"/>
            <column name="created_at"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
