<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
        Every planned task now requires a real backlog task id (the planner's submit_plan tool no
        longer accepts ad-hoc, id-less tasks). Drop any pre-existing id-less rows — they were never
        displayable on the board — and make backlog_task_id NOT NULL so the invariant is enforced
        by the database.
    -->
    <changeSet id="2" author="tasker">
        <!-- Remove slots belonging to id-less planned tasks first (FK fk_planned_task_slot_task). -->
        <delete tableName="planned_task_slot">
            <where>planned_task_id IN (SELECT id FROM planned_task WHERE backlog_task_id IS NULL)</where>
        </delete>

        <delete tableName="planned_task">
            <where>backlog_task_id IS NULL</where>
        </delete>

        <addNotNullConstraint tableName="planned_task" columnName="backlog_task_id" columnDataType="UUID"/>
    </changeSet>

</databaseChangeLog>
