<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <springProperty scope="context" name="ACTIVE_PROFILE" source="spring.profiles.active"/>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>
    <property name="CONSOLE_LOG_PATTERN"
              value="%clr(%d{${LOG_DATEFORMAT_PATTERN:-yyyy-MM-dd HH:mm:ss.SSS}}){faint} %clr(${LOG_LEVEL_PATTERN:-%5p}) %clr(${PID:- }){magenta} %clr(---){faint} %clr([%15.15t]){faint} %clr(user=%X{user:-anonymous}){cyan} %clr(%-40.40logger{39}){cyan} %clr(:){faint} %m%n${LOG_EXCEPTION_CONVERSION_WORD:-%wEx}"/>
    <include resource="org/springframework/boot/logging/logback/console-appender.xml" />

    <!-- Bare-metal prod: full JSON log to a rolling file, only warnings on the console. -->
    <springProfile name="prod &amp; !container">
        <appender name="CONSOLE_WARN" class="ch.qos.logback.core.ConsoleAppender">
            <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
                <level>WARN</level>
            </filter>
            <encoder>
                <pattern>${CONSOLE_LOG_PATTERN}</pattern>
                <charset>${CONSOLE_LOG_CHARSET}</charset>
            </encoder>
        </appender>

        <appender name="JSON_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
            <file>taskboard.log</file>
            <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
                <fileNamePattern>taskboard-%d{yyyy-MM-dd}.log</fileNamePattern>
                <maxHistory>30</maxHistory>
                <totalSizeCap>1GB</totalSizeCap>
            </rollingPolicy>
            <encoder class="net.logstash.logback.encoder.LogstashEncoder">
                <includeMdc>true</includeMdc>
                <includeContext>true</includeContext>
                <includeCallerData>false</includeCallerData>
                <customFields>{"app":"taskboard","environment":"${ACTIVE_PROFILE}"}</customFields>
            </encoder>
        </appender>

        <root level="INFO">
            <appender-ref ref="JSON_FILE" />
            <appender-ref ref="CONSOLE_WARN" />
        </root>
    </springProfile>

    <!-- Everything else, including prod in a container (SPRING_PROFILES_ACTIVE=prod,container): the
         full log on stdout, where `docker logs` and log shippers expect it, and no file inside the
         container's writable layer. -->
    <springProfile name="!prod | container">
        <root level="INFO">
            <appender-ref ref="CONSOLE" />
        </root>
    </springProfile>

    <logger name="org.springframework" level="INFO" />
    <logger name="dev.itayp.tasker" level="DEBUG" />
    <springProfile name="dev">
        <!-- Enable for detailed SQL logs - noisy!
            <logger name="org.springframework.jdbc.core" level="TRACE" />
        -->
    </springProfile>
</configuration>
