{
  "__note": "Backlog.fyi application overview dashboard. Import into Grafana and pick your Prometheus datasource (and a Loki datasource for the logs-based panel). Companion to the default Spring Boot dashboard (vitals/heap/CPU detail/HTTP detail) — this one is the shallow, broad, at-a-glance view. Every Prometheus query is scoped by the `application` label (added by Alloy) so a shared Prometheus serving multiple apps doesn't mix data.",
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "datasource", "uid": "grafana" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "refresh": "1m",
  "schemaVersion": 39,
  "tags": ["backlog", "overview"],
  "templating": {
    "list": [
      {
        "current": {},
        "hide": 0,
        "includeAll": false,
        "label": "Datasource",
        "multi": false,
        "name": "datasource",
        "options": [],
        "query": "prometheus",
        "refresh": 1,
        "regex": "",
        "skipUrlSync": false,
        "type": "datasource"
      },
      {
        "current": { "text": "grafanacloud-itaypk-logs", "value": "grafanacloud-itaypk-logs" },
        "hide": 0,
        "includeAll": false,
        "label": "Logs datasource",
        "multi": false,
        "name": "logs_datasource",
        "options": [],
        "query": "loki",
        "refresh": 1,
        "regex": "",
        "skipUrlSync": false,
        "type": "datasource"
      },
      {
        "current": { "text": "taskboard", "value": "taskboard" },
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "definition": "label_values(process_uptime_seconds, application)",
        "hide": 0,
        "includeAll": false,
        "label": "Application",
        "multi": false,
        "name": "application",
        "options": [],
        "query": { "qryType": 1, "query": "label_values(process_uptime_seconds, application)", "refId": "PrometheusVariableQueryEditor-VariableQuery" },
        "refresh": 1,
        "regex": "",
        "sort": 1,
        "type": "query"
      }
    ]
  },
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "Backlog.fyi — Application Overview",
  "uid": "backlog-overview",
  "version": 1,
  "weekStart": "",
  "panels": [
    {
      "type": "row",
      "title": "Health at a glance",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "panels": []
    },
    {
      "type": "stat",
      "title": "Uptime",
      "description": "Time since the JVM process started. A drop to near-zero means the app restarted.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
      "id": 2,
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": { "mode": "fixed", "fixedColor": "green" },
          "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "yellow", "value": 60 }, { "color": "green", "value": 600 } ] }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none", "textMode": "value" },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "max(process_uptime_seconds{application=\"$application\"})" }
      ]
    },
    {
      "type": "gauge",
      "title": "Process CPU",
      "description": "Recent CPU usage of the JVM process.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 1 },
      "id": 3,
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 0.7 }, { "color": "red", "value": 0.9 } ] }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "orientation": "auto", "showThresholdLabels": false, "showThresholdMarkers": true },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "avg(process_cpu_usage{application=\"$application\"})" }
      ]
    },
    {
      "type": "gauge",
      "title": "System CPU",
      "description": "Recent CPU usage of the whole VPS the app runs on.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 1 },
      "id": 4,
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 0.7 }, { "color": "red", "value": 0.9 } ] }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "orientation": "auto", "showThresholdLabels": false, "showThresholdMarkers": true },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "avg(system_cpu_usage{application=\"$application\"})" }
      ]
    },
    {
      "type": "gauge",
      "title": "Heap used",
      "description": "Used heap as a fraction of max heap.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 1 },
      "id": 5,
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 0.8 }, { "color": "red", "value": 0.92 } ] }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "orientation": "auto", "showThresholdLabels": false, "showThresholdMarkers": true },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "sum(jvm_memory_used_bytes{application=\"$application\", area=\"heap\"}) / sum(jvm_memory_max_bytes{application=\"$application\", area=\"heap\"} > 0)" }
      ]
    },
    {
      "type": "stat",
      "title": "5xx errors (5m)",
      "description": "Server-error responses per second over the last 5 minutes. Anything above zero deserves a look.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 1 },
      "id": 7,
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 3,
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 0.0001 } ] }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none", "textMode": "value" },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "sum(rate(http_server_requests_seconds_count{application=\"$application\", status=~\"5..\"}[5m]))" }
      ]
    },
    {
      "type": "stat",
      "title": "Active users",
      "description": "Claimed users with activity (any authenticated request) in the last 30 days.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 1 },
      "id": 8,
      "fieldConfig": {
        "defaults": { "unit": "short", "color": { "mode": "fixed", "fixedColor": "green" } },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none", "textMode": "value" },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "max(tasker_users_active{application=\"$application\"})" }
      ]
    },
    {
      "type": "row",
      "title": "Vitals over time",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "id": 10,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "CPU",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 10, "x": 0, "y": 6 },
      "id": 11,
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 1, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "calcs": [] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "avg(process_cpu_usage{application=\"$application\"})", "legendFormat": "process" },
        { "refId": "B", "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "avg(system_cpu_usage{application=\"$application\"})", "legendFormat": "system" },
        { "refId": "C", "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "avg(system_load_average_1m{application=\"$application\"}) / avg(system_cpu_count{application=\"$application\"})", "legendFormat": "load avg (1m) / cores" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Memory",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 10, "x": 10, "y": 6 },
      "id": 12,
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 1, "showPoints": "never" }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "heap max" }, "properties": [ { "id": "custom.fillOpacity", "value": 0 }, { "id": "custom.lineStyle", "value": { "fill": "dash", "dash": [8, 4] } }, { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } } ] }
        ]
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "calcs": [] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "sum(jvm_memory_used_bytes{application=\"$application\", area=\"heap\"})", "legendFormat": "heap used" },
        { "refId": "B", "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "sum(jvm_memory_used_bytes{application=\"$application\", area=\"nonheap\"})", "legendFormat": "non-heap used" },
        { "refId": "C", "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "sum(jvm_memory_max_bytes{application=\"$application\", area=\"heap\"} > 0)", "legendFormat": "heap max" }
      ]
    },
    {
      "type": "stat",
      "title": "Disk free",
      "description": "Usable disk on the app's working volume. Single VPS — watch for it filling up.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 4, "x": 20, "y": 6 },
      "id": 6,
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "yellow", "value": 2000000000 }, { "color": "green", "value": 5000000000 } ] }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area", "textMode": "value" },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "min(disk_free_bytes{application=\"$application\"})" }
      ]
    },
    {
      "type": "row",
      "title": "API traffic",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 14 },
      "id": 20,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Requests by status",
      "description": "Request rate grouped by HTTP status. Actuator scrape traffic is excluded.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 15 },
      "id": 21,
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "drawStyle": "bars", "fillOpacity": 70, "lineWidth": 0, "stacking": { "mode": "normal" }, "showPoints": "never" }
        },
        "overrides": [
          { "matcher": { "id": "byRegexp", "options": "/^2../" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } } ] },
          { "matcher": { "id": "byRegexp", "options": "/^3../" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "blue" } } ] },
          { "matcher": { "id": "byRegexp", "options": "/^4../" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } } ] },
          { "matcher": { "id": "byRegexp", "options": "/^5../" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } } ] }
        ]
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "calcs": [] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "sum by (status) (rate(http_server_requests_seconds_count{application=\"$application\", uri!~\"/actuator.*\"}[$__rate_interval]))", "legendFormat": "{{status}}" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Latency (avg & max)",
      "description": "Average latency = rate(sum)/rate(count); max is Micrometer's rolling per-series max. Excludes the synchronous, AI-backed planning-turn endpoints (see 'Planning turn latency') since they block on OpenRouter and aren't representative of normal API response time. NOTE: true p95/p99 require percentile histograms — see the README to enable them.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 15 },
      "id": 22,
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 1, "showPoints": "never" }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "max" }, "properties": [ { "id": "custom.lineStyle", "value": { "fill": "dash", "dash": [8, 4] } }, { "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } } ] }
        ]
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "calcs": ["mean", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "sum(rate(http_server_requests_seconds_sum{application=\"$application\", uri!~\"/actuator.*|/api/v1/planning/(start|{sessionId}/(reply|revise))\"}[$__rate_interval])) / sum(rate(http_server_requests_seconds_count{application=\"$application\", uri!~\"/actuator.*|/api/v1/planning/(start|{sessionId}/(reply|revise))\"}[$__rate_interval]))", "legendFormat": "avg" },
        { "refId": "B", "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "max(http_server_requests_seconds_max{application=\"$application\", uri!~\"/actuator.*|/api/v1/planning/(start|{sessionId}/(reply|revise))\"})", "legendFormat": "max" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Planning turn latency (AI-backed)",
      "description": "Latency of the synchronous web-planning endpoints (start/reply/revise) that block on the OpenRouter call for the duration of the HTTP request. Telegram's planning/quick-add flows run over long-polling, outside the HTTP request thread, so they never appear in http_server_requests_seconds at all.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 15 },
      "id": 23,
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 1, "showPoints": "never" }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "max" }, "properties": [ { "id": "custom.lineStyle", "value": { "fill": "dash", "dash": [8, 4] } }, { "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } } ] }
        ]
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "calcs": ["mean", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "sum(rate(http_server_requests_seconds_sum{application=\"$application\", uri=~\"/api/v1/planning/(start|{sessionId}/(reply|revise))\"}[$__rate_interval])) / sum(rate(http_server_requests_seconds_count{application=\"$application\", uri=~\"/api/v1/planning/(start|{sessionId}/(reply|revise))\"}[$__rate_interval]))", "legendFormat": "avg" },
        { "refId": "B", "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "max(http_server_requests_seconds_max{application=\"$application\", uri=~\"/api/v1/planning/(start|{sessionId}/(reply|revise))\"})", "legendFormat": "max" }
      ]
    },
    {
      "type": "row",
      "title": "AI usage",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 23 },
      "id": 30,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "AI requests / min by model & outcome",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 24 },
      "id": 31,
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "drawStyle": "bars", "fillOpacity": 60, "lineWidth": 0, "showPoints": "never" }
        },
        "overrides": [
          { "matcher": { "id": "byRegexp", "options": "/error/" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } } ] }
        ]
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "calcs": [] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "sum by (model, outcome) (rate(tasker_ai_requests_total{application=\"$application\"}[$__rate_interval])) * 60", "legendFormat": "{{model}} — {{outcome}}" }
      ]
    },
    {
      "type": "timeseries",
      "title": "AI tokens / min by type",
      "description": "Prompt vs completion tokens consumed (stacked = total). Proxy for AI spend. 'cached' (prompt tokens served from cache) and 'cache_write' (tokens written to cache) come from prompt_tokens_details and are subsets of prompt, so they render as un-stacked dashed overlays rather than adding to the total — only present for providers/models that report caching.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 24 },
      "id": 32,
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "drawStyle": "line", "fillOpacity": 20, "lineWidth": 1, "stacking": { "mode": "normal" }, "showPoints": "never" }
        },
        "overrides": [
          {
            "matcher": { "id": "byRegexp", "options": "cached|cache_write" },
            "properties": [
              { "id": "custom.stacking", "value": { "mode": "none" } },
              { "id": "custom.fillOpacity", "value": 0 },
              { "id": "custom.lineStyle", "value": { "fill": "dash", "dash": [8, 4] } }
            ]
          }
        ]
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "calcs": ["sum"] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "sum by (type) (rate(tasker_ai_tokens_total{application=\"$application\"}[$__rate_interval])) * 60", "legendFormat": "{{type}}" }
      ]
    },
    {
      "type": "stat",
      "title": "AI tokens (24h)",
      "description": "Total tokens consumed over the last 24h, split by type. 'cached'/'cache_write' (from prompt_tokens_details) are subsets of prompt — compare 'cached' against 'prompt' to gauge cache-hit rate — and only appear for providers/models that report caching.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 4, "x": 16, "y": 24 },
      "id": 33,
      "fieldConfig": {
        "defaults": { "unit": "short", "color": { "mode": "fixed", "fixedColor": "purple" } },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none", "textMode": "value_and_name", "orientation": "vertical" },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "sum by (type) (increase(tasker_ai_tokens_total{application=\"$application\"}[24h]))", "legendFormat": "{{type}}" }
      ]
    },
    {
      "type": "stat",
      "title": "Active AI conversations",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 4, "x": 20, "y": 24 },
      "id": 34,
      "fieldConfig": {
        "defaults": { "unit": "short", "color": { "mode": "fixed", "fixedColor": "blue" } },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area", "textMode": "value" },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "max(tasker_ai_conversations_active{application=\"$application\"})" }
      ]
    },
    {
      "type": "row",
      "title": "Current totals",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 32 },
      "id": 40,
      "panels": []
    },
    {
      "type": "stat",
      "title": "Users",
      "description": "Total registered users (claimed + unclaimed).",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 6, "w": 4, "x": 0, "y": 33 },
      "id": 41,
      "fieldConfig": {
        "defaults": { "unit": "short", "color": { "mode": "fixed", "fixedColor": "green" } },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area", "textMode": "value" },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "max(tasker_users{application=\"$application\"})" }
      ]
    },
    {
      "type": "bargauge",
      "title": "Users by type",
      "description": "Claimed accounts vs. zero-registration accounts that haven't claimed yet, split by whether they've actually done any work. The three segments sum to total Users. See UsageMetrics.kt / the demo-account-unification doc.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 6, "w": 4, "x": 4, "y": 33 },
      "id": 42,
      "fieldConfig": {
        "defaults": { "unit": "short", "color": { "mode": "palette-classic" } },
        "overrides": []
      },
      "options": { "displayMode": "gradient", "orientation": "horizontal", "reduceOptions": { "calcs": ["lastNotNull"] }, "showUnfilled": true },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "max(tasker_users{application=\"$application\"}) - max(tasker_users_unclaimed{application=\"$application\"})", "legendFormat": "claimed" },
        { "refId": "B", "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "max(tasker_users_unclaimed{application=\"$application\"}) - max(tasker_users_engaged_unclaimed{application=\"$application\"})", "legendFormat": "unclaimed, idle" },
        { "refId": "C", "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "max(tasker_users_engaged_unclaimed{application=\"$application\"})", "legendFormat": "unclaimed, engaged" }
      ]
    },
    {
      "type": "stat",
      "title": "Total tasks",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 6, "w": 4, "x": 8, "y": 33 },
      "id": 43,
      "fieldConfig": {
        "defaults": { "unit": "short", "color": { "mode": "fixed", "fixedColor": "blue" } },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none", "textMode": "value" },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "sum(tasker_tasks{application=\"$application\"})" }
      ]
    },
    {
      "type": "bargauge",
      "title": "Tasks by status",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 33 },
      "id": 44,
      "fieldConfig": {
        "defaults": { "unit": "short", "color": { "mode": "palette-classic" } },
        "overrides": []
      },
      "options": { "displayMode": "gradient", "orientation": "horizontal", "reduceOptions": { "calcs": ["lastNotNull"] }, "showUnfilled": true },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "max by (status) (tasker_tasks{application=\"$application\"})", "legendFormat": "{{status}}" }
      ]
    },
    {
      "type": "bargauge",
      "title": "Planning sessions by status",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 33 },
      "id": 45,
      "fieldConfig": {
        "defaults": { "unit": "short", "color": { "mode": "palette-classic" } },
        "overrides": []
      },
      "options": { "displayMode": "gradient", "orientation": "horizontal", "reduceOptions": { "calcs": ["lastNotNull"] }, "showUnfilled": true },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "max by (status) (tasker_planning_sessions{application=\"$application\"})", "legendFormat": "{{status}}" }
      ]
    },
    {
      "type": "row",
      "title": "Email delivery & quick add",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 39 },
      "id": 60,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Emails sent / min by purpose & outcome",
      "description": "Auth sender (login / register / verification magic links) vs. scheduling sender (calendar invites). A rise in outcome=failure on purpose=auth means users can't log in — see EmailMetricsOutboundChannel.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 40 },
      "id": 61,
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "drawStyle": "bars", "fillOpacity": 60, "lineWidth": 0, "showPoints": "never" }
        },
        "overrides": [
          { "matcher": { "id": "byRegexp", "options": "/failure/" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } } ] }
        ]
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "calcs": [] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "sum by (purpose, outcome) (rate(tasker_email_sent_total{application=\"$application\"}[$__rate_interval])) * 60", "legendFormat": "{{purpose}} — {{outcome}}" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Quick-add outcomes / min",
      "description": "Telegram quick-capture funnel: saved vs. cancelled vs. expired (timed out waiting on the user). A rise in expired relative to saved means people are abandoning the flow — see QuickAddFlow / QuickAddRegistry.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 40 },
      "id": 63,
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "drawStyle": "bars", "fillOpacity": 60, "lineWidth": 0, "showPoints": "never" }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "saved" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } } ] },
          { "matcher": { "id": "byName", "options": "expired" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } } ] }
        ]
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "calcs": [] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "sum by (result) (rate(tasker_quickadd_outcome_total{application=\"$application\"}[$__rate_interval])) * 60", "legendFormat": "{{result}}" }
      ]
    },
    {
      "type": "row",
      "title": "Background jobs & logs",
      "collapsed": true,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 48 },
      "id": 50,
      "panels": [
        {
          "type": "timeseries",
          "title": "Scheduled task runs / min by outcome",
          "description": "Auto-archive, unclaimed-account cleanup, conversation cleanup, usage-metrics refresh. A rise in non-SUCCESS outcomes means a background job is failing.",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "gridPos": { "h": 8, "w": 12, "x": 0, "y": 49 },
          "id": 51,
          "fieldConfig": {
            "defaults": { "unit": "short", "custom": { "drawStyle": "bars", "fillOpacity": 60, "lineWidth": 0, "showPoints": "never" } },
            "overrides": []
          },
          "options": { "legend": { "displayMode": "list", "placement": "bottom", "calcs": [] }, "tooltip": { "mode": "multi", "sort": "desc" } },
          "targets": [
            { "refId": "A", "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "sum by (code_function, outcome) (rate(tasks_scheduled_execution_seconds_count{application=\"$application\"}[$__rate_interval])) * 60", "legendFormat": "{{code_function}} — {{outcome}}" }
          ]
        },
        {
          "type": "timeseries",
          "title": "Log events / min by level",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "gridPos": { "h": 8, "w": 12, "x": 12, "y": 49 },
          "id": 52,
          "fieldConfig": {
            "defaults": { "unit": "short", "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 1, "showPoints": "never" } },
            "overrides": [
              { "matcher": { "id": "byName", "options": "error" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } } ] },
              { "matcher": { "id": "byName", "options": "warn" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } } ] }
            ]
          },
          "options": { "legend": { "displayMode": "list", "placement": "bottom", "calcs": [] }, "tooltip": { "mode": "multi", "sort": "desc" } },
          "targets": [
            { "refId": "A", "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "sum by (level) (rate(logback_events_total{application=\"$application\", level=~\"warn|error\"}[$__rate_interval])) * 60", "legendFormat": "{{level}}" }
          ]
        }
      ]
    },
    {
      "type": "row",
      "title": "Request logs (Loki)",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 57 },
      "id": 70,
      "panels": []
    },
    {
      "type": "logs",
      "title": "Recent application logs",
      "description": "Live tail of the most recent structured log lines for the service.",
      "datasource": { "type": "loki", "uid": "${logs_datasource}" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 58 },
      "id": 72,
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessages": false,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      },
      "targets": [
        { "refId": "A", "datasource": { "type": "loki", "uid": "${logs_datasource}" }, "queryType": "range", "expr": "{service_name=\"tasks\"}" }
      ]
    }
  ]
}
