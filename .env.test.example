# Copy this file to .env.test and fill in your values.
# .env.test is gitignored — never commit real credentials.
#
# Integration tests skip automatically when the required keys are absent,
# so you only need the sections relevant to what you want to run.

# ---------------------------------------------------------------------------
# Email integration tests (EmailIntegrationTest)
# ---------------------------------------------------------------------------
# SMTP credentials — same values you'd use in production.
TASKER_EMAIL_SMTP_HOST=smtp.protonmail.ch
TASKER_EMAIL_SMTP_PORT=587
TASKER_EMAIL_SMTP_USERNAME=your-address@example.com
TASKER_EMAIL_SMTP_PASSWORD=your-smtp-password

# The "From" address that appears in sent mail.
TASKER_EMAIL_FROM=your-address@example.com
TASKER_EMAIL_FROM_NAME=Backlog.fyi Test

# Destination address for the test emails.
TEST_EMAIL_TO=you@example.com

# ---------------------------------------------------------------------------
# Telegram integration tests (TelegramIntegrationTest)
# ---------------------------------------------------------------------------
# Bot token from @BotFather.
TASKER_TELEGRAM_BOT_TOKEN=1234567890:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# The chat ID that will receive the test messages.
# Start a chat with your bot, then visit:
#   https://api.telegram.org/bot<YOUR_TOKEN>/getUpdates
# and read the "chat.id" field from the response.
TEST_TELEGRAM_CHAT_ID=123456789
