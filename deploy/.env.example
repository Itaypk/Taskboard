# Copy to .env and fill in. Everything not listed here is optional; the full reference is
# docs/CONFIGURATION.md and the walkthrough is docs/SELF-HOSTING.md.

# --- Required -------------------------------------------------------------------------------

# The public URL people use to reach this instance, without a trailing slash.
TASKER_APP_BASE_URL=https://tasks.example.com
# Domain for Caddy's certificate (only with `--profile proxy`); usually the host of the URL above.
TASKBOARD_DOMAIN=tasks.example.com

# Database password, used by both the database and the app. Any long random string.
POSTGRES_PASSWORD=

# Key that encrypts task contents and other personal data at rest. Generate with
#   openssl rand -base64 32
# LOSING THIS KEY PERMANENTLY LOSES ALL ENCRYPTED DATA. Back it up somewhere other than your
# database backups.
TASKER_DATA_KEK=

# --- Who can sign in -------------------------------------------------------------------------

# open: anyone can create an account. closed: only the users below and existing accounts.
TASKER_REGISTRATION=closed
# The no-sign-up sandbox creates an account per visitor; off for a private instance.
TASKER_DEMO_ENABLED=false
# Username/password logins, one `username:bcrypt-hash` per line in ./config/users (see the guide).
TASKER_LOCAL_USERS_FILE=/config/users

# --- Branding (optional) -----------------------------------------------------------------------

# TASKER_APP_NAME=My Tasks
# TASKER_SUPPORT_EMAIL=
# TASKER_ABUSE_EMAIL=

# --- AI assistant (optional) -------------------------------------------------------------------

# OpenRouter API key; without it, weekly planning and AI capture are unavailable.
# TASKER_AI_API_KEY=

# --- Email (optional): magic-link sign-in and calendar invitations ---------------------------------

# TASKER_EMAIL_ENABLED=true
# TASKER_EMAIL_AUTH_FROM=
# TASKER_EMAIL_AUTH_SMTP_HOST=
# TASKER_EMAIL_AUTH_SMTP_PORT=587
# TASKER_EMAIL_AUTH_SMTP_USERNAME=
# TASKER_EMAIL_AUTH_SMTP_PASSWORD=
# TASKER_EMAIL_SCHEDULING_FROM=
# TASKER_EMAIL_SCHEDULING_SMTP_HOST=
# TASKER_EMAIL_SCHEDULING_SMTP_PORT=587
# TASKER_EMAIL_SCHEDULING_SMTP_USERNAME=
# TASKER_EMAIL_SCHEDULING_SMTP_PASSWORD=

# --- Telegram (optional): bot and/or sign-in ---------------------------------------------------

# TASKER_TELEGRAM_BOT_TOKEN=
# TASKER_TELEGRAM_BOT_USERNAME=
# TASKER_TELEGRAM_CLIENT_ID=
# TASKER_TELEGRAM_CLIENT_SECRET=
